# ============================================================
# EventEase Backend Environment Variables
# ============================================================

# Server Port (Default: 5000)
PORT=5000

# ------------------------------------------------------------
# Option 1: MongoDB Atlas (Cloud Database - Recommended)
# Replace <username>, <password>, and <cluster-url> with your Atlas details:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/eventease?retryWrites=true&w=majority
#
# Option 2: Local MongoDB (Installed on your computer)
MONGO_URI=mongodb://localhost:27017/eventease
# ------------------------------------------------------------

NODE_ENV=development
